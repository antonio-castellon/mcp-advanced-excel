# Directories this server may read. Use the platform path separator
# (colon on Linux and macOS, semicolon on Windows). Empty means deny all.
# Tool paths must be absolute.
EXCEL_ALLOWED_ROOTS=/data/instruments

# CSV/JSON export is off unless BOTH of the following are set.
EXCEL_ALLOW_WRITE=0
EXCEL_OUTPUT_ROOTS=/data/cleaned

# Optional caps. Values above the built-in ceilings are clamped.
# EXCEL_MAX_FILE_BYTES=26214400
# EXCEL_MAX_ROWS=5000
# EXCEL_MAX_COLUMNS=128
# EXCEL_MAX_SCAN_ROWS=100000

# Secret scrubbing is off unless this is "secrets".
# EXCEL_REDACT=off

# The process does not read a .env from the working directory.
# Set this to an explicit file if you want one loaded.
# EXCEL_DOTENV=/data/instruments/excel.env

# Optional JSON overlay. The file itself must sit inside EXCEL_ALLOWED_ROOTS.
# EXCEL_UNITS_FILE=/data/instruments/units.json
